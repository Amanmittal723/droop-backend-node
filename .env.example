# Purpose: Example environment variables for the Droop Node compatibility backend.
# Expected request body: None.
# Expected query parameters: None.
# Expected headers: None.
# Expected response structure: Environment variable declarations for local setup.

NODE_ENV=development
PORT=2000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/droop_backend_node
LEGACY_PUBLIC_BASE_URL=http://localhost:2000/categories
LEGACY_STORAGE_BASE_URL=http://localhost:2000/storage
LEGACY_STORAGE_ROOT=./storage
LEGACY_THUMBNAILS_ROOT=./runtime/thumbnails
LEGACY_VIDEO_POSTS_ROOT=./runtime/videoPosts
LEGACY_PHP_ROOT=/Volumes/flutterMas/codibex/droop-backend/categories
LEGACY_SQL_DUMP=/Volumes/flutterMas/codibex/droop-backend/droop1988_appdb.sql
SWAGGER_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CLIENT_ID=
WOWZA_API_KEY=
WOWZA_ACCESS_KEY=
SMTP_HOST=mail.droopllc.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=help@droopllc.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=help@droopllc.com
SMTP_FROM_NAME=Droop
APNS_CERT_PATH=
APNS_CERT_PASSPHRASE=
